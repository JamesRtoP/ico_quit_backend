{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Auth": {
    "Mode": "LocalJwt"
  },
  "Fhir": {
    "Url": "",
    "UseManagedIdentity": true
  },
  "Chatbot": {
    "ClientId": "medapp-local-chatbot"
  },
  "Authentication": {
    "Schemes": {
      "Bearer": {
        "ValidAudiences": [
          "https://localhost:7180",
          "http://localhost:5180"
        ],
        "ValidIssuer": "dotnet-user-jwts"
      }
    }
  }
}